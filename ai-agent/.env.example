# Copy to .env for local development. Never commit a real .env file.
PORT=8200
LOG_LEVEL=INFO

# --- AI providers, in strict failover priority order ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=https://veeraops-ecommerce.example.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Internal services ---
MCP_SERVER_URL=http://mcp-server-service:8100/mcp/
MCP_TOOL_TIMEOUT_SECONDS=10
BACKEND_BASE_URL=http://backend-service
AUTH_TIMEOUT_SECONDS=5

# --- Limits / safety ---
AI_REQUEST_TIMEOUT=25
AI_MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=20
CORS_ALLOWED_ORIGINS=*
