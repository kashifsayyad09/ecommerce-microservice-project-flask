# Copy to .env for local development. Never commit a real .env file.
PORT=5000
FLASK_DEBUG=false

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=cloud

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Required for the AI assistant: signs/verifies the customer JWT issued at
# login and used by the ai-agent / mcp-server to call authenticated
# order endpoints on the customer's behalf.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_MINUTES=120
